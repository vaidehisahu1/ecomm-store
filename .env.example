# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime.
# Neon / Vercel Postgres: use the "-pooler" host. Local: same as DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct (non-pooled) connection used by Prisma for migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Auth (Auth.js / NextAuth v5)
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Legacy alias, also accepted by Auth.js. Set one or both to the same value.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Canonical site URL. Local: http://localhost:3000. Production: https://your-domain.com
# (optional on Vercel, where the deployment URL is detected automatically)
NEXTAUTH_URL="http://localhost:3000"
# Trust the X-Forwarded-Host header (required behind proxies; Vercel sets this automatically)
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────────────────────
# Seed accounts (used only by `npm run db:seed`; never commit real values)
# ─────────────────────────────────────────────────────────────
# Passwords must be 8+ chars with an uppercase letter, a lowercase letter and a number.
SEED_ADMIN_PASSWORD="change-me-Admin1"
SEED_USER_PASSWORD="change-me-User1"
# Optional: override the seeded account emails
SEED_ADMIN_EMAIL="admin@example.com"
SEED_USER_EMAIL="customer@example.com"
# The seed DELETES ALL DATA. It refuses to run when NODE_ENV=production, and refuses any
# non-localhost DATABASE_URL unless this is "true". Leave it unset.
# ALLOW_DESTRUCTIVE_SEED="true"

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
# Public URL used for SEO metadata, sitemap, Open Graph and Stripe redirects.
# Falls back to NEXTAUTH_URL, then Vercel's production domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Payments (optional) — leave empty to use the built-in mock card processor
# ─────────────────────────────────────────────────────────────
# Stripe test-mode secret key (sk_test_...)
STRIPE_SECRET_KEY=""
# Signing secret for /api/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=""
# Safety guard: in production (NODE_ENV=production) the mock card processor is DISABLED unless
# Stripe is configured or this is "true". Only enable for public demos — mock orders take no money.
ALLOW_MOCK_PAYMENTS="false"

# ─────────────────────────────────────────────────────────────
# Scheduled jobs
# ─────────────────────────────────────────────────────────────
# Bearer token protecting /api/cron/expire-orders (releases stock from unpaid Stripe orders).
# Vercel Cron sends it automatically when this variable is set. Generate: openssl rand -hex 32
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# Email (Resend) — password reset links and order confirmations
# ─────────────────────────────────────────────────────────────
# Without these, emails are printed to the server console in development; in production
# nothing is sent and the forgot-password form says email reset is unavailable.
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. "Halden <orders@yourdomain.com>"
EMAIL_FROM=""

# ─────────────────────────────────────────────────────────────
# Rate limiting (optional, recommended in production)
# ─────────────────────────────────────────────────────────────
# With both set, rate limits are shared across all serverless instances via Upstash Redis.
# Without them, an in-memory limiter is used (per instance, best-effort). Vercel → Storage →
# Upstash, or console.upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Tests (local only — never set these in Vercel)
# ─────────────────────────────────────────────────────────────
# Separate, disposable database for `npm run test:integration`. Skipped when unset.
# DATABASE_URL_TEST="postgresql://localhost:5432/halden_test"

